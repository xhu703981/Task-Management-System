# Copy to .env and set a real password. docker compose reads .env automatically.
POSTGRES_DB=taskmanagement
POSTGRES_USER=taskmanagement
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Used by the backend (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://taskmanagement:change-me@localhost:5433/taskmanagement

# Signs login tokens (JWT). Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
